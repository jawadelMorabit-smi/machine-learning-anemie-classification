-15T00:53:24.793467Z","iopub.status.idle":"2026-08-15T00:53:25.317538Z","shell.execute_reply":"2026-08-15T00:53:25.316659Z"},"papermill":{"duration":0.538777,"end_time":"2026-08-15T00:53:25.320149+00:00","exception":false,"start_time":"2026-08-15T00:53:24.781372+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1200x900 with 2 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["plt.figure(figsize=(12, 9))\n","sns.heatmap(df.corr(numeric_only=True), annot=True, cmap=\"coolwarm\", fmt=\".2f\")\n","plt.title(\"Matrice de corrélation\")\n","plt.show()"]},{"cell_type":"markdown","id":"2f832e85","metadata":{"papermill":{"duration":0.011977,"end_time":"2026-08-15T00:53:25.344687+00:00","exception":false,"start_time":"2026-08-15T00:53:25.33271+00:00","status":"completed"},"tags":[]},"source":["Interprétation : chaque case montre à quel point deux variables « bougent ensemble » (de -1 à +1). On voit quelques corrélations logiques d'un point de vue médical : RBC↔HGB (0.46), HCT↔MCH (0.61), LYMp↔LYMn (0.47). Aucune paire n'est extrêmement redondante (proche de 1.0), donc on garde toutes les variables. C'est rassurant : pas besoin de supprimer des colonnes."]},{"cell_type":"markdown","id":"2526b13e","metadata":{"papermill":{"duration":0.011649,"end_time":"2026-08-15T00:53:25.368467+00:00","exception":false,"start_time":"2026-08-15T00:53:25.356818+00:00","status":"completed"},"tags":[]},"source":["# **Étape 3 — Prétraitement**"]},{"cell_type":"markdown","id":"c6deb046","metadata":{"papermill":{"duration":0.011478,"end_time":"2026-08-15T00:53:25.391739+00:00","exception":false,"start_time":"2026-08-15T00:53:25.380261+00:00","status":"completed"},"tags":[]},"source":["# 3.1 — Traiter les valeurs aberrantes (impossibles)"]},{"cell_type":"markdown","id":"ddf6a7a6","metadata":{"papermill":{"duration":0.011456,"end_time":"2026-08-15T00:53:25.414994+00:00","exception":false,"start_time":"2026-08-15T00:53:25.403538+00:00","status":"completed"},"tags":[]},"source":["On a vu des valeurs physiquement impossibles : hémoglobine négative, pourcentages > 100, etc. La question : que fait-on avec ?\n","Trois options possibles, et il faut savoir les justifier :\n","\n","(A) Supprimer les lignes aberrantes → simple, mais on perd des patients (surtout grave pour les classes rares).\n","(B) Remplacer par une valeur plausible (la médiane) → on garde la ligne.\n","(C) Borner (clipping) selon les bornes médicalement possibles.\n","\n","Pour un débutant et un dataset déjà petit, je te recommande (C) : corriger les valeurs impossibles en les bornant, car supprimer ferait perdre des cas rares précieux. On définit des bornes médicales réalistes et on « écrase » ce qui dépasse."]},{"cell_type":"code","execution_count":12,"id":"474be6da","metadata":{"execution":{"iopub.execute_input":"2026-08-15T00:53:25.439992Z","iopub.status.busy":"2026-08-15T00:53:25.439068Z","iopub.status.idle":"2026-08-15T00:53:25.496223Z","shell.execute_reply":"2026-08-15T00:53:25.495207Z"},"papermill":{"duration":0.071848,"end_time":"2026-08-15T00:53:25.498451+00:00","exception":false,"start_time":"2026-08-15T00:53:25.426603+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Valeurs aberrantes corrigees par bornage.\n","           WBC     LYMp    NEUTp     LYMn    NEUTn      RBC      HGB      HCT  \\\n","count  1281.00  1281.00  1281.00  1281.00  1281.00  1281.00  1281.00  1281.00   \n","mean      7.86    25.84    72.99     1.88     5.14     4.60    12.08    42.57   \n","std       3.56     7.04     9.33     1.34     2.87     0.80     2.27     6.19   \n","min       0.80     6.20     0.70     0.20     0.50     1.36     0.00     2.00   \n","25%       6.00    25.84    71.10     1.88     5.10     4.19    10.80    39.20   \n","50%       7.40    25.84    77.51     1.88     5.14     4.60    12.30    46.15   \n","75%       8.68    25.84    77.51     1.88     5.14     5.10    13.50    46.15